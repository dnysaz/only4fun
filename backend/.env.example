# ===== Server =====
SERVER_ADDR=:8080
# Frontend URL, used as the redirect target after a successful login
FRONTEND_URL=https://only4.fun
# Origins allowed to call the API (comma separated)
CORS_ORIGINS=https://only4.fun,https://www.only4.fun

# ===== Database =====
DATABASE_PATH=./data/only4.fun.db

# ===== Security =====
# REQUIRED in production. Key used to encrypt GitHub tokens and hash sessions.
# Generate with: openssl rand -hex 32
# Note: changing this value invalidates every existing session.
SESSION_SECRET=

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://api.only4.fun/auth/github/callback

# ===== Cloudflare (automatic DNS) =====
# API token with Zone:DNS:Edit permission for the only4.fun zone
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=only4.fun
# Target of the subdomain record: VPS IP (created as A) or hostname (CNAME)
CLOUDFLARE_TARGET=
# true = traffic goes through the Cloudflare proxy (edge SSL handled automatically)
CLOUDFLARE_PROXY=true

# ===== Build pipeline =====
# docker | local | auto  (auto: docker when the daemon is available)
BUILDER_MODE=auto
# Allow builds to run directly on the host (no Docker). Default false: repository
# scripts would run with the server's permissions, so only enable this if every
# deployable repository is fully trusted.
BUILDER_ALLOW_LOCAL=false
# Image used for builds; must provide node + npm
BUILDER_IMAGE=node:20-alpine
# Temporary working folder for clone + build
CACHE_DIR=/tmp/only4.fun/cache
# Folder where build output is published and served from
SITES_DIR=/var/lib/only4.fun/sites
# Timeout for a single build (seconds)
BUILD_TIMEOUT_SECONDS=600
