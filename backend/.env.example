# ===== Server =====
SERVER_ADDR=:8080
# Frontend URL, used as the redirect target after a successful login.
# Local development with Vite: http://localhost:5173
FRONTEND_URL=https://only4.fun
# Origins allowed to call the API (comma separated).
# Local development: http://localhost:5173,http://localhost:8080
CORS_ORIGINS=https://only4.fun,https://www.only4.fun
# CIDRs of reverse proxies allowed to set X-Forwarded-For, CF-Connecting-IP and
# X-Forwarded-Proto. Default: loopback only. Behind Cloudflare, use Cloudflare's
# published IP ranges so clients get separate rate-limit buckets.
TRUSTED_PROXIES=127.0.0.1,::1
# Local development only: enables /auth/dev-login. GET shows a form, POST signs
# you in as a demo account (with sample projects) without GitHub. Only accepts
# localhost requests and loopback Origin headers. Never enable in production.
DEV_LOGIN=false

# ===== Database =====
DATABASE_PATH=./data/only4.fun.db

# ===== Security =====
# REQUIRED in production. Key used to encrypt GitHub tokens and hash sessions.
# Generate with: openssl rand -hex 32
# Note: changing this value invalidates every existing session.
SESSION_SECRET=

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://api.only4.fun/auth/github/callback

# ===== Cloudflare (automatic DNS + custom hostname SSL) =====
# API token needs Zone:DNS:Edit (project records) and
# Zone:SSL and Certificates:Edit (custom_hostnames API) for the only4.fun zone.
# Enable Cloudflare for SaaS on the zone (SSL/TLS > Custom Hostnames) for
# automatic certificates on user domains. Without it, custom domains are still
# stored and served, but automatic SSL is unavailable.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=only4.fun
# Target of the subdomain record: VPS IP (created as A) or hostname (CNAME)
CLOUDFLARE_TARGET=
# true = traffic goes through the Cloudflare proxy (edge SSL handled automatically)
CLOUDFLARE_PROXY=true

# ===== Build pipeline =====
# Builds always run directly on the host (git clone + npm build). Only accept
# repositories you trust: their install/build scripts run with the server's user.
# Temporary working folder for clone + build
CACHE_DIR=/tmp/only4.fun/cache
# Folder where build output is published and served from
SITES_DIR=/var/lib/only4.fun/sites
# Timeout for a single build (seconds)
BUILD_TIMEOUT_SECONDS=600
