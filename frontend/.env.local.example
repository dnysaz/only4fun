# Frontend environment variables
# Copy this file to .env.local and fill in your values

# Backend API URL (used for fetches and OAuth redirects)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public frontend origin, used for SEO metadata, canonical URLs, robots and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub OAuth is handled by the backend (see backend/.env.example):
# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET must never live in the frontend,
# because everything bundled here is sent to the browser.
